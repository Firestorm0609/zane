# === Telegram ===
# Create a bot with @BotFather, put the token here
TELEGRAM_BOT_TOKEN=

# === Pump.fun callout polling ===
# RECOMMENDED for feed mode (~2s polls): install pump_forwarder.user.js in
# Tampermonkey and keep a pump.fun tab open — it forwards your Privy session
# token to the bot automatically (PUMP_INGEST_PORT below).
# Manual one-shot: python3 pumpfarm.py --set-token "eyJ..."
# (token from DevTools -> Network -> a frontend-api request -> Authorization)
PUMP_AUTH_TOKEN=
# Local HTTP port the userscript POSTs the token to (+ POST /callouts, the
# optional callout relay — see pump_forwarder.user.js).
PUMP_INGEST_HOST=127.0.0.1
PUMP_INGEST_PORT=8766
# Optional shared secret; must match KEY in pump_forwarder.user.js. Blank = no
# check, which is fine: the port is bound to localhost and only reachable
# through the tunnel.
PUMP_INGEST_KEY=
# Optional egress for pump.fun requests ONLY: http:// or https:// proxy URL,
# credentials inline if needed (http://user:pass@host:port).
# Set this when pump.fun throttles the host's IP (symptoms: `429 ... cooling
# down 600s` then "MISSED" callout alerts minutes late). Pumping callout
# detection through this host costs a couple of requests a minute; through a
# clean IP it polls at POLL_INTERVAL_S. RPC, trades, Telegram and the SOL/USD
# feed stay direct. SOCKS5 needs the aiohttp_socks package.
PUMP_PROXY=
# Optional: move the callout/metadata egress to a different IP. Point this at a
# host you control that proxies the same paths to pump.fun (a rewrite works:
# /pump/(.*) -> https://frontend-api-v3.pump.fun/$1), and pump.fun sees that
# host's IP instead of this one — its ~13-requests/600s budget is counted per
# egress IP, so this is the only way to poll faster than one host allows.
# Leave blank to poll pump.fun directly.
PUMP_CALLOUT_BASE=

# === Trading ===
# Solana RPC endpoint for sending trades and reading balances.
# Use a private RPC (Helius/QuickNode) — the public one is heavily rate-limited.
SOLANA_RPC=https://api.mainnet-beta.solana.com

# 32-byte HEX key used to encrypt imported wallets at rest.
# MUST be valid hex (64 hex chars) — generate it with:
#   python -c "import os; print(os.urandom(32).hex())"
WALLET_ENC_KEY=

# === Safety ===
# Hard cap per buy, in SOL. The bot refuses bigger buys.
MAX_BUY_SOL=0.05
# Minimum SOL balance a wallet must keep after a buy
MIN_SOL_LEFT=0.01
